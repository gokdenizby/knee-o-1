(self.df)\n","\n","    def __getitem__(self, idx):\n","        study_id = str(self.df.iloc[idx]['StudyInstanceUID'])\n","        npz_file = os.path.join(self.cache_dir, f\"{study_id}.npz\")\n","        \n","        if os.path.exists(npz_file):\n","            try:\n","                data = np.load(npz_file)\n","                sag = torch.tensor(data['sag'], dtype=torch.float32)\n","                cor = torch.tensor(data['cor'], dtype=torch.float32)\n","                ax  = torch.tensor(data['ax'],  dtype=torch.float32)\n","            except Exception:\n","                sag = torch.zeros((4, 3, 224, 224), dtype=torch.float32)\n","                cor = torch.zeros((4, 3, 224, 224), dtype=torch.float32)\n","                ax  = torch.zeros((4, 3, 224, 224), dtype=torch.float32)\n","        else:\n","            sag = torch.zeros((4, 3, 224, 224), dtype=torch.float32)\n","            cor = torch.zeros((4, 3, 224, 224), dtype=torch.float32)\n","            ax  = torch.zeros((4, 3, 224, 224), dtype=torch.float32)\n","\n","        return {'study_id': study_id, 'sagittal': sag, 'coronal': cor, 'axial': ax}\n","\n","fast_test_dataset = UltraFastNPZDataset(df_test, NPZ_CACHE_DIR)\n","\n","# NPZ RAM'e çok hızlı geldiği için batch_size=16 yapabiliriz\n","fast_test_loader = DataLoader(\n","    fast_test_dataset,\n","    batch_size=16,\n","    shuffle=False,\n","    num_workers=4,\n","    pin_memory=True,\n","    drop_last=False\n",")\n","\n","# 4. Kullanılacak En İyi Modeller (Max 5 Adet Ensemble)\n","available_weights = []\n","available_weights.extend([p for p in RAD_FOLD_HEADS if os.path.exists(p)])\n","if os.path.exists(E11_HEADS_PATH): available_weights.append(E11_HEADS_PATH)\n","if os.path.exists(E9_HEADS_PATH):  available_weights.append(E9_HEADS_PATH)\n","available_weights.extend([p for p in RSNA2026_MODELS if os.path.exists(p)])\n","\n","# En etkili 5 modeli seç\n","available_weights = available_weights[:5]\n","print(f\"Ensemble Edilecek Model Sayısı: {len(available_weights)}\")\n","\n","# 5. Batch Inference Fonksiyonu\n","@torch.no_grad()\n","def run_fast_inference(model, dataloader, device):\n","    model.eval()\n","    all_preds = []\n","    for batch in tqdm(dataloader, desc=\"Fast Batch Inference\", leave=False):\n","        sag = batch['sagittal'].to(device, non_blocking=True)\n","        cor = batch['coronal'].to(device, non_blocking=True)\n","        ax  = batch['axial'].to(device, non_blocking=True)\n","        with torch.cuda.amp.autocast(enabled=True):\n","            logits = model(sag, cor, ax)\n","            probs  = torch.sigmoid(logits)\n","        all_preds.append(probs.cpu().numpy())\n","    return np.vstack(all_preds)\n","\n","all_model_predictions = []\n","\n","for idx, ckpt_path in enumerate(available_weights):\n","    print(f\"\\n[{idx+1}/{len(available_weights)}] Yükleniyor: {os.path.basename(ckpt_path)}\")\n","    model = RSNAKneeMultiViewNet(weights_path=RADIMAGENET_BACKBONE_PATH, num_classes=12).to(DEVICE)\n","    \n","    try:\n","        state_dict = torch.load(ckpt_path, map_location=DEVICE)\n","        if 'model' in state_dict: state_dict = state_dict['model']\n","        if 'state_dict' in state_dict: state_dict = state_dict['state_dict']\n","        model.load_state_dict(state_dict, strict=False)\n","        print(\"  [+] Ağırlıklar başarıyla yüklendi.\")\n","    except Exception as e:\n","        print(f\"  [!] Uyarı: {e}\")\n","\n","    fold_preds = run_fast_inference(model, fast_test_loader, DEVICE)\n","    all_model_predictions.append(fold_preds)\n","    \n","    del model\n","    torch.cuda.empty_cache()\n","    gc.collect()\n","\n","# 6. Rank Averaging ile Birleştir\n","if len(all_model_predictions) > 1:\n","    print(\"\\n--> Modeller Rank Averaging ile birleştiriliyor...\")\n","    n_models = len(all_model_predictions)\n","    n_samples, n_classes = all_model_predictions[0].shape\n","    rank_sum = np.zeros((n_samples, n_classes), dtype=np.float64)\n","    \n","    for preds in all_model_predictions:\n","        for c in range(n_classes):\n","            rank_sum[:, c] += stats.rankdata(preds[:, c]) / float(n_samples)\n","    final_probabilities = rank_sum / float(n_models)\n","else:\n","    final_probabilities = all_model_predictions[0]\n","\n","# 7. submission.csv Kaydet ve Doğrula\n","sub_df = pd.DataFrame({'StudyInstanceUID': df_test['StudyInstanceUID']})\n","for idx, col in enumerate(TARGET_COLUMNS):\n","    sub_df[col] = final_probabilities[:, idx]\n","\n","sub_df.to_csv(\"/kaggle/working/submission.csv\", index=False)\n","\n","assert sub_df.shape == (len(df_test), 13), f\"HATA: Boyut {sub_df.shape}\"\n","assert not sub_df.isnull().any().any(), \"HATA: NaN değerler var!\"\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"🎉 [BAŞARILI] submission.csv rekor hızda üretildi!\")\n","print(f\"Boyut: {sub_df.shape}\")\n","print(sub_df.head())\n","print(\"=\" * 70)"]},{"cell_type":"code","execution_count":null,"id":"a9d4b530","metadata":{"papermill":{"duration":0.00511,"end_time":"2026-08-18T20:01:09.336399+00:00","exception":false,"start_time":"2026-08-18T20:01:09.331289+00:00","status":"completed"},"tags":[]},"outputs":[],"source":[]}],"metadata":{"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"competition","sourceId":154281},{"sourceType":"datasetVersion","sourceId":18229736},{"sourceType":"datasetVersion","sourceId":18673450},{"sourceType":"datasetVersion","sourceId":18673646},{"sourceType":"datasetVersion","sourceId":18706996},{"sourceType":"datasetVersion","sourceId":18715672},{"sourceType":"datasetVersion","sourceId":18716507},{"sourceType":"datasetVersion","sourceId":18757740},{"sourceType":"datasetVersion","sourceId":18839182},{"sourceType":"datasetVersion","sourceId":18842180},{"sourceType":"datasetVersion","sourceId":18875869},{"sourceType":"datasetVersion","sourceId":18956429},{"sourceType":"kernelVersion","sourceId":342671664},{"sourceType":"kernelVersion","sourceId":342849430},{"sourceType":"kernelVersion","source