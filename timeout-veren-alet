=======================\n","# CELL 10 (ULTRA FAST): Timeout-Proof Submission in 15-20 Minutes\n","# ==============================================================================\n","import os\n","import glob\n","import pandas as pd\n","import numpy as np\n","import torch\n","import torch.nn.functional as F\n","import scipy.stats as stats\n","from torch.utils.data import DataLoader\n","from tqdm.auto import tqdm\n","import gc\n","\n","print(\"=\" * 70)\n","print(\"ULTRA FAST INFERENCE - TIMEOUT PROOF VERSION\")\n","print(\"=\" * 70)\n","\n","# --- CONFIG ---\n","BATCH_SIZE_INF   = 8    # Batch boyutu (GPU bellegi yeterliyse 16 yapilabilir)\n","NUM_WORKERS_INF  = 4    # Paralel disk okuma islemcisi\n","MAX_MODELS       = 5    # En fazla 5 model kullan (daha hizli, ayni guc)\n","USE_TTA          = False # Hiz icin kapali\n","\n","# --- 1. TEST VERİSİ ---\n","df_test = pd.read_csv(TEST_CSV_PATH)\n","print(f\"Test Vaka Sayisi: {len(df_test)}\")\n","\n","test_dataset = RSNAKneeMultiViewDataset(\n","    df=df_test,\n","    series_dir=TEST_SERIES_DIR,\n","    num_stacks_per_plane=8,\n","    is_training=False\n",")\n","\n","# Batch DataLoader (Paralel I/O ile 4x hiz)\n","test_loader = DataLoader(\n","    test_dataset,\n","    batch_size=BATCH_SIZE_INF,\n","    shuffle=False,\n","    num_workers=NUM_WORKERS_INF,\n","    pin_memory=True,\n","    drop_last=False,\n","    prefetch_factor=2,\n","    persistent_workers=True\n",")\n","\n","print(f\"DataLoader hazirlandi: {len(test_loader)} batch x {BATCH_SIZE_INF} sample/batch\")\n","\n","# --- 2. KULLANILACAK MODELLERİ SEÇ (Max 5 Adet) ---\n","available_weights = []\n","available_weights.extend([p for p in RAD_FOLD_HEADS if os.path.exists(p)])\n","if os.path.exists(E11_HEADS_PATH): available_weights.append(E11_HEADS_PATH)\n","if os.path.exists(E9_HEADS_PATH):  available_weights.append(E9_HEADS_PATH)\n","available_weights.extend([p for p in RSNA2026_MODELS if os.path.exists(p)])\n","\n","if not available_weights:\n","    available_weights = sorted(glob.glob(\"/kaggle/input/**/*.pt\", recursive=True))\n","\n","# En fazla MAX_MODELS adet kullan\n","available_weights = available_weights[:MAX_MODELS]\n","print(f\"Kullanilacak Model Sayisi: {len(available_weights)}\")\n","for w in available_weights:\n","    print(f\"  [+] {os.path.basename(w)}\")\n","\n","# --- 3. ULTRA FAST BATCH INFERENCE (Her Modeli Batch ile Calistir) ---\n","@torch.no_grad()\n","def batch_inference(model, dataloader, device):\n","    \"\"\"\n","    Tum test setini batch halinde islер.\n","    Sample-by-sample yerine 8 hasta ayni anda GPU'ya gider.\n","    \"\"\"\n","    model.eval()\n","    all_preds = []\n","\n","    for batch in tqdm(dataloader, desc=\"Batch Inference\", leave=True):\n","        sag = batch['sagittal'].to(device, non_blocking=True)\n","        cor = batch['coronal'].to(device, non_blocking=True)\n","        ax  = batch['axial'].to(device, non_blocking=True)\n","\n","        with torch.cuda.amp.autocast(enabled=True):\n","            logits = model(sag, cor, ax)\n","            probs  = torch.sigmoid(logits)\n","\n","        all_preds.append(probs.cpu().numpy())\n","\n","    return np.vstack(all_preds)\n","\n","all_model_predictions = []\n","\n","for idx, ckpt_path in enumerate(available_weights):\n","    print(f\"\\n[{idx+1}/{len(available_weights)}] Yukleniyor: {os.path.basename(ckpt_path)}\")\n","\n","    model = RSNAKneeMultiViewNet(\n","        weights_path=RADIMAGENET_BACKBONE_PATH,\n","        num_classes=12\n","    ).to(DEVICE)\n","\n","    try:\n","        state_dict = torch.load(ckpt_path, map_location=DEVICE)\n","        if 'model' in state_dict:\n","            state_dict = state_dict['model']\n","        if 'state_dict' in state_dict:\n","            state_dict = state_dict['state_dict']\n","        model.load_state_dict(state_dict, strict=False)\n","        print(f\"  Agirliklar basariyla yuklendi.\")\n","    except Exception as e:\n","        print(f\"  [!] Uyari: {e}\")\n","\n","    fold_preds = batch_inference(model, test_loader, DEVICE)\n","    all_model_predictions.append(fold_preds)\n","    print(f\"  Tamamlandi: {fold_preds.shape}\")\n","\n","    # GPU bellegini temizle\n","    del model\n","    torch.cuda.empty_cache()\n","    gc.collect()\n","\n","# --- 4. RANK AVERAGING ENSEMBLE ---\n","print(\"\\nRank Averaging ile modeller birlestiriliyor...\")\n","\n","def compute_rank_averaging(predictions_list):\n","    n_models  = len(predictions_list)\n","    n_samples, n_classes = predictions_list[0].shape\n","    rank_matrix = np.zeros((n_samples, n_classes), dtype=np.float64)\n","\n","    for preds in predictions_list:\n","        for c in range(n_classes):\n","            rank_matrix[:, c] += stats.rankdata(preds[:, c]) / float(n_samples)\n","\n","    return rank_matrix / float(n_models)\n","\n","if len(all_model_predictions) > 1:\n","    final_probabilities = compute_rank_averaging(all_model_predictions)\n","else:\n","    final_probabilities = all_model_predictions[0]\n","\n","# --- 5. SUBMISSION.CSV OLUŞTUR ---\n","sub_df = pd.DataFrame({'StudyInstanceUID': df_test['StudyInstanceUID']})\n","for col_idx, col_name in enumerate(TARGET_COLUMNS):\n","    sub_df[col_name] = final_probabilities[:, col_idx]\n","\n","submission_file = \"/kaggle/working/submission.csv\"\n","sub_df.to_csv(submission_file, index=False)\n","\n","# Dogrulama\n","assert sub_df.shape[1] == 13, f\"HATA: Beklenen 13 sutun, bulunan {sub_df.shape[1]}\"\n","assert not sub_df.isnull().any().any(), \"HATA: NaN deger tespit edildi!\"\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(f\"[BASARILI] submission.csv olusturuldu!\")\n","print(f\"Dosya    : {submission_file}\")\n","print(f\"Boyut    : {sub_df.shape}\")\n","print(sub_df.head())\n","print(\"=\" * 70)"]},{"cell_type":"code","execution_count":null,"id":"175ce75c","metadata":{"papermill":{"duration":0.003898,"end_time":"2026-08-18T18:44:32.5893+00:00","exception":false,"start_time":"2026-08-18T18:44:32.585402+00:00","status":"completed"