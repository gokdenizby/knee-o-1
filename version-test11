n","    torch.manual_seed(seed)\n","    torch.cuda.manual_seed(seed)\n","    torch.cuda.manual_seed_all(seed)\n","    torch.backends.cudnn.deterministic = True\n","\n","seed_everything(42)\n","\n","# 2. 12 Official Target Pathologies\n","TARGET_COLUMNS = [\n","    'ACL', 'MCL', 'Medial Meniscus', 'Lateral Meniscus',\n","    'Medial OA', 'Lateral OA', 'PF OA', 'Effusion',\n","    'Synovitis', \"Baker's\", 'Contusion', 'Fracture'\n","]\n","\n","# 3. Competition Paths\n","DATA_DIR = \"/kaggle/input/competitions/rsna-knee-abnormality-detection\"\n","if not os.path.exists(DATA_DIR):\n","    DATA_DIR = \"/kaggle/input/rsna-knee-abnormality-detection\"\n","\n","TRAIN_CSV_PATH        = os.path.join(DATA_DIR, \"train.csv\")\n","TEST_CSV_PATH         = os.path.join(DATA_DIR, \"test.csv\")\n","TRAIN_SERIES_CSV_PATH = os.path.join(DATA_DIR, \"train_series.csv\")\n","TEST_SERIES_CSV_PATH  = os.path.join(DATA_DIR, \"test_series.csv\")\n","TRAIN_SERIES_DIR      = os.path.join(DATA_DIR, \"train_series\")\n","TEST_SERIES_DIR       = os.path.join(DATA_DIR, \"test_series\")\n","\n","# 4. LLM Soft-Label Datasets\n","LLM_V4_BLEND_PATH = \"/kaggle/input/datasets/stevenleehans/rsna-knee-llm-report-labels/llm_labels_v4_blend.csv\"\n","LLM_GPT_PATH      = \"/kaggle/input/datasets/lixin73/rsna-knee-llm-report-labels-sol56/report_labels_gpt56sol.csv\"\n","LLM_PILKWANG_PATH = \"/kaggle/input/datasets/pilkwang/rsna-knee-llm-labels/report_labels_v2.csv\"\n","\n","if os.path.exists(LLM_V4_BLEND_PATH):\n","    LLM_LABELS_PATH = LLM_V4_BLEND_PATH\n","elif os.path.exists(LLM_GPT_PATH):\n","    LLM_LABELS_PATH = LLM_GPT_PATH\n","else:\n","    LLM_LABELS_PATH = LLM_PILKWANG_PATH\n","\n","# 5. Pretrained Weights (RadImageNet, Folds, Models)\n","RADIMAGENET_BACKBONE_PATH = \"/kaggle/input/datasets/marwanmath/resnet-50-radimagenet-marwan/ResNet50.pt\"\n","\n","RAD_FOLD_HEADS = [\n","    f\"/kaggle/input/datasets/mattiaangeli/rsna-knee-radimagenet-foldsv1-heads/rad_head_f{i}.pt\"\n","    for i in range(5)\n","]\n","\n","E11_HEADS_PATH = \"/kaggle/input/datasets/antoinegg1/rsna-knee-e11-diverse-heads-v20/v52_e11_heads.pt\"\n","E9_HEADS_PATH  = \"/kaggle/input/datasets/antoinegg1/rsna-knee-e9-radimagenet-heads-v15/v52_radimagenet_heads.pt\"\n","\n","RSNA2026_MODELS = [\n","    f\"/kaggle/input/datasets/tonylica/rsna2026-models/rsna_20260807_v{i}.pt\"\n","    for i in range(1, 5)\n","]\n","\n","DINOV2_SMALL_DIR = \"/kaggle/input/models/metaresearch/dinov2/pytorch/small/1\"\n","DINOV2_BASE_DIR  = \"/kaggle/input/models/metaresearch/dinov2/pytorch/base/1\"\n","\n","OUTPUT_DIR = \"/kaggle/working\"\n","os.makedirs(OUTPUT_DIR, exist_ok=True)\n","DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","\n","print(\"=\" * 75)\n","print(f\"COMPUTE DEVICE               : {DEVICE}\")\n","print(f\"train.csv                    : {'[MEVCUT]' if os.path.exists(TRAIN_CSV_PATH) else '[BULUNAMADI]'}\")\n","print(f\"train_series.csv             : {'[MEVCUT]' if os.path.exists(TRAIN_SERIES_CSV_PATH) else '[BULUNAMADI]'}\")\n","print(f\"LLM Soft Labels (Active)     : {LLM_LABELS_PATH}\")\n","print(f\"RadImageNet Backbone         : {'[MEVCUT]' if os.path.exists(RADIMAGENET_BACKBONE_PATH) else '[BULUNAMADI]'}\")\n","print(f\"DINOv2 Base Model            : {'[MEVCUT]' if os.path.exists(DINOV2_BASE_DIR) else '[BULUNAMADI]'}\")\n","print(\"=\" * 75)"]},{"cell_type":"code","execution_count":2,"id":"09b80807","metadata":{"execution":{"iopub.execute_input":"2026-08-18T09:00:51.631289Z","iopub.status.busy":"2026-08-18T09:00:51.630555Z","iopub.status.idle":"2026-08-18T09:00:51.85257Z","shell.execute_reply":"2026-08-18T09:00:51.851567Z"},"papermill":{"duration":0.227408,"end_time":"2026-08-18T09:00:51.85448+00:00","exception":false,"start_time":"2026-08-18T09:00:51.627072+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Total Studies in train.csv: 4407\n"]}],"source":["# ==============================================================================\n","# CELL 2: Ingest train.csv & Map Series to Anatomical Planes (Sag/Cor/Ax)\n","# ==============================================================================\n","df_train = pd.read_csv(TRAIN_CSV_PATH)\n","df_train_series = pd.read_csv(TRAIN_SERIES_CSV_PATH) if os.path.exists(TRAIN_SERIES_CSV_PATH) else None\n","\n","print(f\"Total Studies in train.csv: {len(df_train)}\")\n","\n","def get_series_plane(desc):\n","    d = str(desc).lower()\n","    if 'sag' in d:\n","        return 'Sagittal'\n","    elif 'cor' in d:\n","        return 'Coronal'\n","    elif 'ax' in d or 'tra' in d:\n","        return 'Axial'\n","    return 'Unknown'\n","\n","if df_train_series is not None and 'SeriesDescription' in df_train_series.columns:\n","    df_train_series['plane'] = df_train_series['SeriesDescription'].apply(get_series_plane)\n","    print(\"\\nPlane breakdown in train_series.csv:\")\n","    print(df_train_series['plane'].value_counts())"]},{"cell_type":"code","execution_count":3,"id":"5302bfc6","metadata":{"execution":{"iopub.execute_input":"2026-08-18T09:00:51.861505Z","iopub.status.busy":"2026-08-18T09:00:51.860928Z","iopub.status.idle":"2026-08-18T09:00:52.245473Z","shell.execute_reply":"2026-08-18T09:00:52.244827Z"},"papermill":{"duration":0.389673,"end_time":"2026-08-18T09:00:52.246966+00:00","exception":false,"start_time":"2026-08-18T09:00:51.857293+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["--> Ingesting high-quality LLM soft labels from: /kaggle/input/datasets/stevenleehans/rsna-knee-llm-report-labels/llm_labels_v4_blend.csv\n","\n","Final Supervised Dataset Statistics:\n","  - Gold Standard Cases : 58\n","  - Weakly Supervised   : 4349\n","  - Total Studies       : 4407\n"]}],"source":["# ==============================================================================\n","# CELL 3: Merge Gold Standard Labels with LLM Soft-Labels\n","# ==============================================================================\n","def is_annotated(row):\n","    for col in TARGET_COLUMNS:\n","        val = str(row[col]).strip()\n","        if val != '' and val != 'nan' and not pd.isna(row[col]):\n","            return True\n","    return False\n","\n","df_train['is_gold'] = df_train.apply(is_annotated, axis=1)\n","\n","if os.path.exists(LLM_LABELS_PATH):\n","    print(f\"--> Ingesting high-quality LLM soft labels from: {LLM_LABELS_PATH}\")\n","    df_llm = pd.read_csv(LLM_LABELS_PATH)\n","    \n","    df_merged = df_train.copy()\n","    for col in TARGET_COLUMNS:\n","        if col in df_llm.columns:\n","            unlabeled_mask = (df_merged['is_gold'] == False)\n","            llm_map = df_llm.set_index('StudyInstanceUID')[col].to_dict()\n","            df_merged.loc[unlabeled_mask, col] = df_merged.loc[unlabeled_mask, 'StudyInstanceUID'].map(llm_map).fillna(0.0)\n","            df_merged[col] = pd.to_numeric(df_merged[col], errors='coerce').fillna(0.0).astype(np.float32)\n","else:\n","    df_merged = df_train.copy()\n","    for col in TARGET_COLUMNS:\n","        df_merged[col] = pd.to_numeric(df_merged[col], errors='coerce').fillna(0.0).astype(np.float32)\n","\n","print(f\"\\nFinal Supervised Dataset Statistics:\")\n","print(f\"  - Gold Standard Cases : {df_merged['is_gold'].sum()}\")\n","print(f\"  - Weakly Supervised   : {len(df_merged) - df_merged['is_gold'].sum()}\")\n","print(f\"  - Total Studies       : {len(df_merged)}\")\n","\n","df_merged.to_csv(\"/kaggle/working/train_soft_labels_merged.csv\", index=False)"]},{"cell_type":"code","execution_count":4,"id":"654396fb","metadata":{"execution":{"iopub.execute_input":"2026-08-18T09:00:52.253307Z","iopub.status.busy":"2026-08-18T09:00:52.252874Z","iopub.status.idle":"2026-08-18T09:00:52.263333Z","shell.execute_reply":"2026-08-18T09:00:52.262625Z"},"papermill":{"duration":0.015221,"end_time":"2026-08-18T09:00:52.264773+00:00","exception":false,"start_time":"2026-08-18T09:00:52.249552+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# ==============================================================================\n","# CELL 4: DICOM Plane Solver and 2.5D Volumetric Stack Extractor\n","# ==============================================================================\n","def parse_plane_from_iop(iop):\n","    if iop is None or len(iop) < 6:\n","        return \"Unknown\"\n","    Xx, Xy, Xz = [float(v) for v in iop[:3]]\n","    Yx, Yy, Yz = [float(v) for v in iop[3:6]]\n","    Zx = Xy * Yz - Xz * Yy\n","    Zy = Xz * Yx - Xx * Yz\n","    Zz = Xx * Yy - Xy * Yx\n","    \n","    abs_zx, abs_zy, abs_zz = abs(Zx), abs(Zy), abs(Zz)\n","    if abs_zx > abs_zy and abs_zx > abs_zz:\n","        return \"Sagittal\"\n","    elif abs_zy > abs_zx and abs_zy > abs_zz:\n","        return \"Coronal\"\n","    else:\n","        return \"Axial\"\n","\n","def read_and_window_slice(dcm_path, img_size=(384, 384)):\n","    try:\n","        dcm = pydicom.dcmread(dcm_path)\n","        img = dcm.pixel_array.astype(np.float32)\n","        \n","        # Percentile contrast windowing\n","        p1, p99 = np.percentile(img, (1, 99))\n","        if p99 > p1:\n","            img = np.clip(img, p1, p99)\n","            img = (img - p1) / (p99 - p1)\n","        else:\n","            img = img / (img.max() + 1e-6)\n","            \n","        img = (img * 255.0).astype(np.uint8)\n","        if img.shape != img_size:\n","            img = cv2.resize(img, img_size, interpolation=cv2.INTER_AREA)\n","        return img\n","    except Exception:\n","        return np.zeros(img_size, dtype=np.uint8)\n","\n","def extract_25d_stacks(slice_paths, num_stacks=8, img_size=(384, 384)):\n","    \"\"\"Extracts num_stacks 3-channel 2.5D slices [num_stacks, 3, H, W]\"\"\"\n","    total = len(slice_paths)\n","    if total == 0:\n","        return np.zeros((num_stacks, 3, img_size[0], img_size[1]), dtype=np.float32)\n","    \n","    indices = np.linspace(0, total - 1, num_stacks, dtype=int)\n","    stacks = []\n","    for idx in indices:\n","        p_idx = max(0, idx - 1)\n","        n_idx = min(total - 1, idx + 1)\n","        \n","        s0 = read_and_window_slice(slice_paths[p_idx], img_size)\n","        s1 = read_and_window_slice(slice_paths[idx], img_size)\n","        s2 = read_and_window_slice(slice_paths[n_idx], img_size)\n","        \n","        stack = np.stack([s0, s1, s2], axis=0).astype(np.float32) / 255.0\n","        stacks.append(stack)\n","    return np.array(stacks, dtype=np.float32)"]},{"cell_type":"code","execution_count":5,"id":"507592fc","metadata":{"execution":{"iopub.execute_input":"2026-08-18T09:00:52.270885Z","iopub.status.busy":"2026-08-18T09:00:52.270597Z","iopub.status.idle":"2026-08-18T09:00:58.329822Z","shell.execute_reply":"2026-08-18T09:00:58.329186Z"},"papermill":{"duration":6.064675,"end_time":"2026-08-18T09:00:58.331761+00:00","exception":false,"start_time":"2026-08-18T09:00:52.267086+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# ==============================================================================\n","# CELL 5: Multi-View PyTorch Dataset (Sagittal, Coronal, Axial Routing)\n","# ==============================================================================\n","import torchvision.transforms as T\n","\n","class AnatomyPreservingAugmentation:\n","    def __init__(self, is_training=True):\n","        self.is_training = is_training\n","        \n","    def __call__(self, stacks):\n","        tensor = torch.tensor(stacks, dtype=torch.float32)\n","        if not self.is_training:\n","            return tensor\n","        \n","        angle = float(np.random.uniform(-7.0, 7.0))\n","        scale = float(np.random.uniform(0.96, 1.04))\n","        brightness = float(np.random.uniform(0.92, 1.08))\n","        \n","        for s in range(tensor.shape[0]):\n","            slice_img = tensor[s]\n","            slice_img = T.functional.affine(slice_img, angle=angle, translate=[0, 0], scale=scale, shear=0)\n","            slice_img = torch.clamp(slice_img * brightness, 0.0, 1.0)\n","            tensor[s] = slice_img\n","        return tensor\n","\n","class RSNAKneeMultiViewDataset(Dataset):\n","    def __init__(self, df, series_dir, num_stacks_per_plane=8, img_size=(384, 384), is_training=True):\n","        self.df = df.reset_index(drop=True)\n","        self.series_dir = series_dir\n","        self.num_stacks = num_stacks_per_plane\n","        self.img_size = img_size\n","        self.transform = AnatomyPreservingAugmentation(is_training=is_training)\n","        \n","    def __len__(self):\n","        return len(self.df)\n","        \n","    def _route_study_series(self, study_id):\n","        study_path = os.path.join(self.series_dir, str(study_id))\n","        dcm_files = glob.glob(os.path.join(study_path, \"**\", \"*.dcm\"), recursive=True)\n","        \n","        plane_buckets = {\"Sagittal\": [], \"Coronal\": [], \"Axial\": []}\n","        for dcm_p in dcm_files:\n","            try:\n","                hdr = pydicom.dcmread(dcm_p, stop_before_pixels=True)\n","                iop = getattr(hdr, 'ImageOrientationPatient', None)\n","                plane = parse_plane_from_iop(iop)\n","                if plane == \"Unknown\":\n","                    desc = str(getattr(hdr, 'SeriesDescription', '')).lower()\n","                    if 'sag' in desc: plane = 'Sagittal'\n","                    elif 'cor' in desc: plane = 'Coronal'\n","                    elif 'ax' in desc or 'tra' in desc: plane = 'Axial'\n","                \n","                pos = getattr(hdr, 'ImagePositionPatient', None)\n","                z_loc = float(pos[2]) if pos is not None else float(getattr(hdr, 'InstanceNumber', 0))\n","                \n","                if plane in plane_buckets:\n","                    plane_buckets[plane].append((z_loc, dcm_p))\n","            except Exception:\n","                continue\n","                \n","        routed = {}\n","        for p in [\"Sagittal\", \"Coronal\", \"Axial\"]:\n","            items = plane_buckets[p]\n","            items.sort(key=lambda x: x[0])\n","            routed[p] = [x[1] for x in items]\n","        return routed\n","\n","    def __getitem__(self, idx):\n","        row = self.df.iloc[idx]\n","        study_id = row['StudyInstanceUID']\n","        routed = self._route_study_series(study_id)\n","        \n","        sag_stacks = extract_25d_stacks(routed[\"Sagittal\"], self.num_stacks, self.img_size)\n","        cor_stacks = extract_25d_stacks(routed[\"Coronal\"], self.num_stacks, self.img_size)\n","        ax_stacks  = extract_25d_stacks(routed[\"Axial\"], self.num_stacks, self.img_size)\n","        \n","        labels = torch.tensor(row[TARGET_COLUMNS].values.astype(np.float32), dtype=torch.float32) if all(c in row for c in TARGET_COLUMNS) else torch.zeros(len(TARGET_COLUMNS))\n","        \n","        return {\n","            'study_id': study_id,\n","            'sagittal': self.transform(sag_stacks),\n","            'coronal': self.transform(cor_stacks),\n","            'axial': self.transform(ax_stacks),\n","            'labels': labels\n","        }"]},{"cell_type":"code","execution_count":6,"id":"fd4eb74a","metadata":{"execution":{"iopub.execute_input":"2026-08-18T09:00:58.339189Z","iopub.status.busy":"2026-08-18T09:00:58.338744Z","iopub.status.idle":"2026-08-18T09:00:58.531827Z","shell.execute_reply":"2026-08-18T09:00:58.531051Z"},"papermill":{"duration":0.198738,"end_time":"2026-08-18T09:00:58.533539+00:00","exception":false,"start_time":"2026-08-18T09:00:58.334801+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# ==============================================================================\n","# CELL 6 (FIXED): 100% Offline Multi-View MIL with LayerNorm (No BatchNorm Bug)\n","# ==============================================================================\n","import torchvision.models as models\n","\n","class RadImageNetBackbone(nn.Module):\n","    def __init__(self, weights_path=RADIMAGENET_BACKBONE_PATH):\n","        super().__init__()\n","        self.model = models.resnet50(weights=None)\n","        \n","        if weights_path and os.path.exists(weights_path):\n","            state_dict = torch.load(weights_path, map_location='cpu')\n","            if 'state_dict' in state_dict:\n","                state_dict = state_dict['state_dict']\n","            elif 'model' in state_dict:\n","                state_dict = state_dict['model']\n","                \n","            clean_dict = {k.replace('module.', ''): v for k, v in state_dict.items() if not k.startswith('fc')}\n","            self.model.load_state_dict(clean_dict, strict=False)\n","            print(f\"[SUCCESS] Loaded offline RadImageNet weights from: {weights_path}\")\n","            \n","        self.num_features = self.model.fc.in_features # 2048\n","        self.model.fc = nn.Identity()\n","\n","    def forward(self, x):\n","        return self.model(x)\n","\n","class GatedAttentionMIL(nn.Module):\n","    def __init__(self, in_features, hidden_dim=256):\n","        super().__init__()\n","        self.attention_V = nn.Sequential(nn.Linear(in_features, hidden_dim), nn.Tanh())\n","        self.attention_U = nn.Sequential(nn.Linear(in_features, hidden_dim), nn.Sigmoid())\n","        self.attention_weights = nn.Linear(hidden_dim, 1)\n","\n","    def forward(self, x):\n","        v = self.attention_V(x)\n","        u = self.attention_U(x)\n","        weights = self.attention_weights(v * u)\n","        alpha = torch.softmax(weights, dim=1)\n","        pooled = torch.sum(x * alpha, dim=1)\n","        return pooled, alpha\n","\n","class RSNAKneeMultiViewNet(nn.Module):\n","    def __init__(self, weights_path=RADIMAGENET_BACKBONE_PATH, num_classes=12):\n","        super().__init__()\n","        self.backbone = RadImageNetBackbone(weights_path=weights_path)\n","        feat_dim = self.backbone.num_features\n","\n","        self.mil_sag = GatedAttentionMIL(feat_dim)\n","        self.mil_cor = GatedAttentionMIL(feat_dim)\n","        self.mil_ax  = GatedAttentionMIL(feat_dim)\n","\n","        # LayerNorm kullanarak batch_size=1 çökmesini tamamen önlüyoruz:\n","        self.classifier = nn.Sequential(\n","            nn.Linear(feat_dim * 3, 512),\n","            nn.LayerNorm(512),\n","            nn.SiLU(),\n","            nn.Dropout(0.35),\n","            nn.Linear(512, num_classes)\n","        )\n","\n","    def _forward_plane(self, plane_tensor, mil_module):\n","        b, s, c, h, w = plane_tensor.shape\n","        x_reshaped = plane_tensor.view(b * s, c, h, w)\n","        feats = self.backbone(x_reshaped)\n","        feats = feats.view(b, s, -1)\n","        pooled, _ = mil_module(feats)\n","        return pooled\n","\n","    def forward(self, sag, cor, ax):\n","        f_sag = self._forward_plane(sag, self.mil_sag)\n","        f_cor = self._forward_plane(cor, self.mil_cor)\n","        f_ax  = self._forward_plane(ax, self.mil_ax)\n","        \n","        fused = torch.cat([f_sag, f_cor, f_ax], dim=1)\n","        logits = self.classifier(fused)\n","        return logits"]},{"cell_type":"code","execution_count":7,"id":"0f80f274","metadata":{"execution":{"iopub.execute_input":"2026-08-18T09:00:58.539898Z","iopub.status.busy":"2026-08-18T09:00:58.539583Z","iopub.status.idle":"2026-08-18T09:00:58.562698Z","shell.execute_reply":"2026-08-18T09:00:58.561795Z"},"papermill":{"duration":0.028437,"end_time":"2026-08-18T09:00:58.564563+00:00","exception":false,"start_time":"2026-08-18T09:00:58.536126+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["5-Fold Validation Structure:\n","  Fold 0: Total = 882, Gold Cases = 12\n","  Fold 1: Total = 882, Gold Cases = 12\n","  Fold 2: Total = 882, Gold Cases = 12\n","  Fold 3: Total = 881, Gold Cases = 11\n","  Fold 4: Total = 880, Gold Cases = 11\n"]}],"source":["# ==============================================================================\n","# CELL 7: Asymmetric Loss for Soft Labels & Stratified Split\n","# ==============================================================================\n","class AsymmetricLossWithSoftLabels(nn.Module):\n","    def __init__(self, gamma_neg=4, gamma_pos=1, clip=0.05, eps=1e-8):\n","        super().__init__()\n","        self.gamma_neg = gamma_neg\n","        self.gamma_pos = gamma_pos\n","        self.clip = clip\n","        self.eps = eps\n","\n","    def forward(self, logits, targets):\n","        probs = torch.sigmoid(logits)\n","        pos_loss = targets * torch.log(probs.clamp(min=self.eps)) * ((1 - probs) ** self.gamma_pos)\n","        \n","        p_neg = (1 - probs).clamp(min=self.eps)\n","        if self.clip > 0:\n","            p_neg = (1 - (probs - self.clip).clamp(min=0)).clamp(min=self.eps)\n","            \n","        neg_loss = (1 - targets) * torch.log(p_neg) * (probs ** self.gamma_neg)\n","        return - (pos_loss + neg_loss).mean()\n","\n","def create_stratified_folds(df, n_splits=5, seed=42):\n","    df_folds = df.copy().reset_index(drop=True)\n","    df_folds['fold'] = -1\n","    \n","    gold_idx = df_folds[df_folds['is_gold'] == True].index.values\n","    unlabeled_idx = df_folds[df_folds['is_gold'] == False].index.values\n","    \n","    kf = KFold(n_splits=n_splits, shuffle=True, random_state=seed)\n","    for fold, (_, val_idx) in enumerate(kf.split(gold_idx)):\n","        df_folds.loc[gold_idx[val_idx], 'fold'] = fold\n","    for fold, (_, val_idx) in enumerate(kf.split(unlabeled_idx)):\n","        df_folds.loc[unlabeled_idx[val_idx], 'fold'] = fold\n","        \n","    return df_folds\n","\n","df_folds = create_stratified_folds(df_merged, n_splits=5, seed=42)\n","print(\"5-Fold Validation Structure:\")\n","for f in range(5):\n","    print(f\"  Fold {f}: Total = {(df_folds['fold'] == f).sum()}, Gold Cases = {((df_folds['fold'] == f) & (df_folds['is_gold'])).sum()}\")"]},{"cell_type":"code","execution_count":8,"id":"b20cd782","metadata":{"execution":{"iopub.execute_input":"2026-08-18T09:00:58.571503Z","iopub.status.busy":"2026-08-18T09:00:58.571276Z","iopub.status.idle":"2026-08-18T09:00:58.580641Z","shell.execute_reply":"2026-08-18T09:00:58.579966Z"},"papermill":{"duration":0.014879,"end_time":"2026-08-18T09:00:58.582135+00:00","exception":false,"start_time":"2026-08-18T09:00:58.567256+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# ==============================================================================\n","# CELL 8: Training Engine with Mixed-Precision (AMP) & ROC-AUC Tracking\n","# ==============================================================================\n","def evaluate_roc_auc(y_true, y_pred):\n","    auc_scores = []\n","    for c in range(y_true.shape[1]):\n","        y_t = (y_true[:, c] >= 0.5).astype(int)\n","        y_p = y_pred[:, c]\n","        if len(np.unique(y_t)) > 1:\n","            auc_scores.append(roc_auc_score(y_t, y_p))\n","    return np.mean(auc_scores) if len(auc_scores) > 0 else 0.0\n","\n","def train_epoch(model, dataloader, optimizer, scheduler, criterion, scaler, device):\n","    model.train()\n","    total_loss = 0.0\n","    for batch in tqdm(dataloader, desc=\"Training\", leave=False):\n","        sag = batch['sagittal'].to(device, non_blocking=True)\n","        cor = batch['coronal'].to(device, non_blocking=True)\n","        ax  = batch['axial'].to(device, non_blocking=True)\n","        targets = batch['labels'].to(device, non_blocking=True)\n","        \n","        optimizer.zero_grad()\n","        with torch.cuda.amp.autocast(enabled=True):\n","            logits = model(sag, cor, ax)\n","            loss = criterion(logits, targets)\n","            \n","        scaler.scale(loss).backward()\n","        scaler.step(optimizer)\n","        scaler.update()\n","        scheduler.step()\n","        total_loss += loss.item()\n","    return total_loss / len(dataloader)\n","\n","@torch.no_grad()\n","def validate_epoch(model, dataloader, criterion, device):\n","    model.eval()\n","    total_loss = 0.0\n","    y_trues, y_preds = [], []\n","    for batch in tqdm(dataloader, desc=\"Validation\", leave=False):\n","        sag = batch['sagittal'].to(device, non_blocking=True)\n","        cor = batch['coronal'].to(device, non_blocking=True)\n","        ax  = batch['axial'].to(device, non_blocking=True)\n","        targets = batch['labels'].to(device, non_blocking=True)\n","        \n","        with torch.cuda.amp.autocast(enabled=True):\n","            logits = model(sag, cor, ax)\n","            loss = criterion(logits, targets)\n","            probs = torch.sigmoid(logits)\n","            \n","        total_loss += loss.item()\n","        y_trues.append(targets.cpu().numpy())\n","        y_preds.append(probs.cpu().numpy())\n","        \n","    auc = evaluate_roc_auc(np.vstack(y_trues), np.vstack(y_preds))\n","    return total_loss / len(dataloader), auc"]},{"cell_type":"code","execution_count":9,"id":"6fb48ab4","metadata":{"execution":{"iopub.execute_input":"2026-08-18T09:00:58.588447Z","iopub.status.busy":"2026-08-18T09:00:58.587974Z","iopub.status.idle":"2026-08-18T09:00:58.595843Z","shell.execute_reply":"2026-08-18T09:00:58.594982Z"},"papermill":{"duration":0.012975,"end_time":"2026-08-18T09:00:58.597565+00:00","exception":false,"start_time":"2026-08-18T09:00:58.58459+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# ==============================================================================\n","# CELL 9: TTA Engine & Grandmaster Rank Averaging Ensemble\n","# ==============================================================================\n","@torch.no_grad()\n","def predict_with_tta(model, sag, cor, ax, device):\n","    model.eval()\n","    with torch.cuda.amp.autocast(enabled=True):\n","        p_base = torch.sigmoid(model(sag.to(device), cor.to(device), ax.to(device))).cpu().numpy()\n","        \n","        # Multi-scale Zoom TTA\n","        s_zoom = F.interpolate(sag.squeeze(0), scale_factor=1.05, mode='bilinear', align_corners=False)[:, :, 9:393, 9:393].unsqueeze(0).to(device)\n","        c_zoom = F.interpolate(cor.squeeze(0), scale_factor=1.05, mode='bilinear', align_corners=False)[:, :, 9:393, 9:393].unsqueeze(0).to(device)\n","        a_zoom = F.interpolate(ax.squeeze(0),  scale_factor=1.05, mode='bilinear', align_corners=False)[:, :, 9:393, 9:393].unsqueeze(0).to(device)\n","        \n","        p_tta = torch.sigmoid(model(s_zoom, c_zoom, a_zoom)).cpu().numpy()\n","        \n","    return 0.65 * p_base + 0.35 * p_tta\n","\n","def compute_rank_averaging(predictions_list):\n","    \"\"\"Blends multi-fold and multi-model probability outputs using rank percentiles.\"\"\"\n","    n_models = len(predictions_list)\n","    n_samples, n_classes = predictions_list[0].shape\n","    rank_matrix = np.zeros((n_samples, n_classes), dtype=np.float64)\n","    \n","    for preds in predictions_list:\n","        for c in range(n_classes):\n","            rank_matrix[:, c] += stats.rankdata(preds[:, c]) / float(n_samples)\n","            \n","    return rank_matrix / float(n_models)"]},{"cell_type":"code","execution_count":10,"id":"b830c3e0","metadata":{"execution":{"iopub.execute_input":"2026-08-18T09:00:58.603985Z","iopub.status.busy":"2026-08-18T09:00:58.60348Z","iopub.status.idle":"2026-08-18T09:02:04.044399Z","shell.execute_reply":"2026-08-18T09:02:04.043411Z"},"papermill":{"duration":65.450006,"end_time":"2026-08-18T09:02:04.050097+00:00","exception":false,"start_time":"2026-08-18T09:00:58.600091+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["======================================================================\n","HAZIR MODELLERLE HIZLI INFERENCE VE SUBMISSION BASLIYOR\n","======================================================================\n","Toplam Test Vaka Sayisi: 3\n","--> Kullanilacak Hazir Model Sayisi: 11\n","Inference yapiliyor: rad_head_f0.pt\n","[SUCCESS] Loaded offline RadImageNet weights from: /kaggle/input/data